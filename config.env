# ============ 内核源码 ============
KERNEL_SOURCE=https://github.com/yushihao0525/msm8998
KERNEL_SOURCE_BRANCH=lineage-23.2

# ============ 机型配置 ============
KERNEL_DEFCONFIG=vendor/xiaomi/mi8998_defconfig
KERNEL_FRAGMENT=arch/arm64/configs/vendor/xiaomi/sagit.config

# ============ 编译器 ============
# ★ clang 12（已验证能编过）；clang 17 会触发 mnt_id 重复定义
CLANG_BRANCH=android12-release
CLANG_DIR=clang-r416183b

# ============ 输出名称 ============
KERNEL_ZIP_NAME=Sagit-ReSukiSU-SUSFS-LOS232

# ============ KernelSU ============
ENABLE_KERNELSU=true

# ============ SUSFS ============
ENABLE_SUSFS=true
SUSFS_BRANCH=kernel-4.9

SUSFS_SUS_PATH=true
SUSFS_SUS_MOUNT=true
SUSFS_SUS_KSTAT=true
SUSFS_SPOOF_STAT=true
SUSFS_TRY_UMOUNT=true
SUSFS_OPEN_REDIRECT=true
SUSFS_SUS_SU=true
SUSFS_SUS_OVERLAYFS=true
SUSFS_SPOOF_CMDLINE=true
SUSFS_AUTO_ADD_BIND_MOUNT=true
SUSFS_AUTO_ADD_KSTAT=true
# 需 kernel/sys.c 补丁：该文件被 ROM 魔改，强制关闭
SUSFS_SPOOF_UNAME=false
SUSFS_HIDE_SYMBOLS=true
SUSFS_ENABLE_LOG=true

EXTRA_CONFIG=

# ============ 自定义补丁 ============
ENABLE_CUSTOM_PATCHES=true
