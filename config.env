# ============ 内核源码 ============
KERNEL_SOURCE=https://github.com/yushihao0525/msm8998
KERNEL_SOURCE_BRANCH=lineage-24.0

# ============ 机型配置（小米6 sagit / 骁龙835 msm8998）============
KERNEL_DEFCONFIG=vendor/xiaomi/mi8998_defconfig
KERNEL_FRAGMENT=arch/arm64/configs/vendor/xiaomi/sagit.config

# ============ 输出名称 ============
KERNEL_ZIP_NAME=Sagit-ReSukiSU-SUSFS

# ============ KernelSU ============
# true = 集成 ReSukiSU（4.4 走 manual hook）
ENABLE_KERNELSU=true

# ============ SUSFS ============
# 官方源已迁 GitLab，workflow 内已配多镜像回退
# 小米6 是 4.4，官方最低 kernel-4.9，属 backport（XDA 有 4.4 成功案例）
ENABLE_SUSFS=true
SUSFS_BRANCH=kernel-4.9

# 4.4 缺 set_memory，ReSukiSU/SUSFS 需要反向移植
# 编译若报 set_memory 相关错误，把它设 true（已是则检查 .rej）
ENABLE_SET_MEMORY=true

# ============ 自定义补丁 ============
# true = 应用 patches/ 目录里的 .patch（修 SUSFS 冲突用）
ENABLE_CUSTOM_PATCHES=true
