# ============ 内核源码 ============
KERNEL_SOURCE=https://github.com/yushihao0525/msm8998
KERNEL_SOURCE_BRANCH=lineage-24.0

# ============ 机型配置（小米6 sagit / 骁龙835 msm8998）============
KERNEL_DEFCONFIG=vendor/xiaomi/mi8998_defconfig
KERNEL_FRAGMENT=arch/arm64/configs/vendor/xiaomi/sagit.config

# ============ 输出名称 ============
KERNEL_ZIP_NAME=Sagit-ReSukiSU

# ============ KernelSU ============
# 集成 ReSukiSU，4.4 走 manual hook（已开 CONFIG_KSU_MANUAL_HOOK）
ENABLE_KERNELSU=true

# ============ SUSFS ============
# 小米6 是 4.4，SUSFS 官方最低 kernel-4.9
# kernel/sys.c 在 4.4 上必冲突，需手工移植，本轮先关闭
# 等纯 KSU 内核刷机验证能开机后，再回来单独做 SUSFS 移植
ENABLE_SUSFS=false
SUSFS_BRANCH=kernel-4.9

# ============ set_memory 反向移植 ============
# 该补丁是给 SukiSU-Ultra 的 KPM 功能用的，ReSukiSU 不需要
# 且源地址已 404，官方也标注"仅在需要 KPM 时使用" → 关闭
ENABLE_SET_MEMORY=false

# ============ 自定义补丁 ============
ENABLE_CUSTOM_PATCHES=true
